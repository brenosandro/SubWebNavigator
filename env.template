# SubWebNavigator — copie para .env e ajuste. NUNCA commite o .env.
# Atalho para desenvolvimento: `npm run setup` gera o .env com segredos aleatórios.
# Gere segredos com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3460
# Origem pública do app (mesma do navegador). Dev: Vite em 5180 com proxy /api.
APP_ORIGIN=http://localhost:5180
# true somente atrás de proxy confiável (cloudflared/nginx) para ler o IP real.
TRUST_PROXY=false

# ── Banco (docker compose local) ─────────────────────────────────────────────
POSTGRES_USER=subweb_app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=subweb
DATABASE_URL=postgresql://subweb_app:CHANGE_ME@127.0.0.1:5446/subweb
# Banco DESCARTÁVEL da suíte de integração (ela apaga os dados). Nunca igual a DATABASE_URL.
TEST_DATABASE_URL=postgresql://subweb_app:CHANGE_ME@127.0.0.1:5446/subweb_test

# ── Google OIDC ──────────────────────────────────────────────────────────────
# Console Google Cloud → Credenciais → ID do cliente OAuth (aplicativo da Web).
# URI de redirecionamento autorizado: <APP_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5180/api/auth/google/callback
# Allowlist do titular (MVP: um único titular). Preferir também o `sub`.
OWNER_GOOGLE_EMAILS=
OWNER_GOOGLE_SUBS=
# >= 32 caracteres (obrigatório em produção)
OAUTH_STATE_SECRET=

# ── Chave de segurança (WebAuthn) ────────────────────────────────────────────
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=SubWebNavigator
WEBAUTHN_RP_ORIGIN=http://localhost:5180
# Recusa passkeys sincronizadas: exige chave física (obrigatório em produção).
ENFORCE_HARDWARE_WEBAUTHN=true
# SÓ DEV: dispensa o código de cadastro da primeira chave.
WEBAUTHN_DEV_OPEN_ENROLLMENT=false

# ── Criptografia de campos (32 bytes base64) ─────────────────────────────────
DATA_ENCRYPTION_KEY=

# ── Política (tetos do ambiente) ─────────────────────────────────────────────
SESSION_MAX_HOURS=12
MFA_PENDING_MINUTES=10
STEP_UP_MINUTES=5
DEFAULT_IDLE_MINUTES=5
MAX_IDLE_MINUTES=30
DEFAULT_VIEWER_ABSOLUTE_MINUTES=30
MAX_VIEWER_ABSOLUTE_MINUTES=60
URL_POLICY_RESOLVE_DNS=true

# ── Cloudflare Access (produção: true) ───────────────────────────────────────
ENFORCE_ACCESS_JWT=false
CF_ACCESS_TEAM_DOMAIN=https://SEU_TIME.cloudflareaccess.com
CF_ACCESS_AUDIENCE=

# ── SÓ DEV: login sem Google para este e-mail (proibido em produção) ─────────
DEV_LOGIN_EMAIL=

# ── Runtime remoto ──────────────────────────────────────────────────────────
# Controller: único componente com acesso ao Docker (API e web nunca acessam).
CONTROLLER_HOST=127.0.0.1
CONTROLLER_PORT=3470
CONTROLLER_URL=http://127.0.0.1:3470
# >= 32 caracteres; o MESMO valor na API e no controller (HMAC).
CONTROLLER_SECRET=
# Relay da rede dos workers (docker compose publica em 127.0.0.1:7460).
RELAY_URL=ws://127.0.0.1:7460
WORKER_IMAGE=subweb-worker:dev
WORKER_NETWORK=subweb_workers
MAX_SIMULTANEOUS_WORKERS=3
WORKER_MEMORY_LIMIT_MB=1536
WORKER_CPU_LIMIT=1.5
STREAM_TICKET_TTL_SECONDS=30
STREAM_AUTH_RECHECK_SECONDS=5
