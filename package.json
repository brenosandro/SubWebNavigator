{
  "name": "subwebnavigator",
  "version": "0.1.0",
  "description": "Navegador pessoal remoto self-hosted, multi-contas, com perfis isolados (monorepo)",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "node scripts/setup-dev.mjs",
    "postinstall": "npm run build -w @subweb/protocol",
    "dev": "concurrently -k -n api,ctl,web -c blue,magenta,green \"npm run dev -w @subweb/api\" \"npm run dev -w @subweb/controller\" \"npm run dev -w @subweb/web\"",
    "dev:api": "npm run dev -w @subweb/api",
    "dev:web": "npm run dev -w @subweb/web",
    "dev:controller": "npm run dev -w @subweb/controller",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "worker:image": "docker build -f infra/docker/Dockerfile.worker -t subweb-worker:dev .",
    "prisma:generate": "npm run prisma:generate -w @subweb/api",
    "migrate:dev": "npm run db:migrate:dev -w @subweb/api",
    "migrate:deploy": "npm run db:migrate:deploy -w @subweb/api",
    "owner:enrollment-code": "npm run owner:enrollment-code -w @subweb/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run build -w @subweb/protocol && npm run typecheck --workspaces --if-present",
    "test": "npm run build -w @subweb/protocol && npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration -w @subweb/api",
    "start": "npm run start -w @subweb/api"
  },
  "author": "Datatoms",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.2.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/brenosandro/SubWebNavigator.git"
  }
}
