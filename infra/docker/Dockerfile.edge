# ─────────────────────────────────────────────────────────────────────────────
# SubWebNavigator · Borda da rede dos workers: proxy de egress e relay.
# A mesma imagem roda os dois serviços (comandos diferentes no compose).
# ─────────────────────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/protocol/package.json packages/protocol/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/edge/package.json apps/edge/package.json
COPY apps/controller/package.json apps/controller/package.json
RUN npm ci --no-audit --no-fund --ignore-scripts -w @subweb/edge
COPY apps/edge apps/edge
RUN npm run build -w @subweb/edge \
  && mkdir -p /out/node_modules \
  && printf '{"type":"module","private":true}' > /out/package.json \
  && cp -r node_modules/ws node_modules/ipaddr.js /out/node_modules/ \
  && cp -r apps/edge/dist /out/dist

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /out/ /app/
USER node
CMD ["node", "dist/main-egress.js"]
