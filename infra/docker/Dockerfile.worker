# ─────────────────────────────────────────────────────────────────────────────
# SubWebNavigator · Worker de navegador (um container por perfil ativo).
# Chromium do Debian (atualizações de segurança do bookworm) + Xvfb.
# Roda como UID 1000, rootfs somente leitura, sandbox do Chromium LIGADO.
# Build context: raiz do monorepo.
# ─────────────────────────────────────────────────────────────────────────────
FROM node:25-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/protocol/package.json packages/protocol/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/edge/package.json apps/edge/package.json
COPY apps/controller/package.json apps/controller/package.json
RUN npm ci --no-audit --no-fund --ignore-scripts -w @subweb/worker -w @subweb/protocol
COPY packages/protocol packages/protocol
COPY apps/worker apps/worker
RUN npm run build -w @subweb/protocol && npm run build -w @subweb/worker \
  && mkdir -p /out/node_modules \
  && printf '{"type":"module","private":true}' > /out/package.json \
  && cp -r node_modules/ws node_modules/zod /out/node_modules/ \
  && mkdir -p /out/node_modules/@subweb/protocol \
  && cp -r packages/protocol/package.json packages/protocol/dist /out/node_modules/@subweb/protocol/ \
  && cp -r apps/worker/dist /out/dist

FROM node:25-bookworm-slim AS runtime
LABEL swn.image=worker
RUN apt-get update \
  && apt-get install -y --no-install-recommends chromium xvfb dumb-init ca-certificates \
     fonts-liberation fonts-noto-core fonts-noto-cjk fonts-noto-color-emoji locales \
  && sed -i 's/^# pt_BR.UTF-8/pt_BR.UTF-8/' /etc/locale.gen && locale-gen \
  && rm -rf /var/lib/apt/lists/* \
  # O sandbox SUID não é usado (cap_drop ALL + no-new-privileges): só namespaces.
  && rm -f /usr/lib/chromium/chrome-sandbox \
  && mkdir -p /profile && chown 1000:1000 /profile
ENV NODE_ENV=production HOME=/tmp/home XDG_CONFIG_HOME=/tmp/home/.config XDG_CACHE_HOME=/tmp/home/.cache \
    CHROMIUM_PATH=/usr/bin/chromium PROFILE_DIR=/profile/chromium WORKER_PORT=7070
WORKDIR /app
COPY --from=build /out/ /app/
USER 1000:1000
VOLUME ["/profile"]
EXPOSE 7070
HEALTHCHECK --interval=5s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:7070/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["dumb-init", "--single-child", "--"]
CMD ["node", "dist/agent.js"]
