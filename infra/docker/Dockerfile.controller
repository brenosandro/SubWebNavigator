# ─────────────────────────────────────────────────────────────────────────────
# SubWebNavigator · Worker controller. Build context: raiz do monorepo.
#
# ÚNICO componente com o socket do Docker (API e web nunca). Ele fala
# com a API só por HMAC, numa rede `internal`, e só executa `docker` com
# argumentos fixos (apps/controller/src/docker.ts). Roda como root porque o
# socket do Docker é root — quem tem o socket já é root no host, então o
# isolamento real é: nenhuma porta exposta, rede interna, HMAC e argumentos fixos.
# ─────────────────────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/protocol/package.json packages/protocol/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/edge/package.json apps/edge/package.json
COPY apps/controller/package.json apps/controller/package.json
RUN npm ci --no-audit --no-fund --ignore-scripts -w @subweb/controller
COPY apps/controller apps/controller
RUN npm run build -w @subweb/controller \
  && mkdir -p /out/node_modules \
  && printf '{"type":"module","private":true}' > /out/package.json \
  && cp -r node_modules/zod /out/node_modules/ \
  && cp -r apps/controller/dist /out/dist

FROM docker:27.5.1-cli AS dockercli

FROM node:22-bookworm-slim AS runtime
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
ENV NODE_ENV=production CONTROLLER_HOST=0.0.0.0 CONTROLLER_PORT=3470 \
    WORKER_SECCOMP_PROFILE=/app/seccomp-chromium.json WORKER_NETWORK=subweb_workers
WORKDIR /app
COPY --from=build /out/ /app/
COPY infra/worker/seccomp-chromium.json /app/seccomp-chromium.json
EXPOSE 3470
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3470/v1/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/main.js"]
