{
  "name": "@subweb/protocol",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Protocolo limitado entre navegador, gateway e worker (validado com zod nas duas pontas)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
