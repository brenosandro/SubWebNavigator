{
  "name": "@subweb/controller",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Worker controller: único componente com acesso ao Docker; sobe/para/suspende workers isolados",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
